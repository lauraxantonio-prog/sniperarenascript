	local l = new("TextLabel", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = "" }, r)
	local function paint() l.Text = text .. ":  " .. tostring(S[key]) .. "   ›" end
	paint()
	b.MouseButton1Click:Connect(function()
		local idx = table.find(options, S[key]) or 0
		S[key] = options[idx % #options + 1]
		paint()
		save()
		if cb then cb(S[key]) end
	end)
end

function Tab:Button(text, cb, danger)
	local r = self:row(36)
	r.BackgroundTransparency = 1
	local b = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = danger and Color3.fromRGB(116, 40, 52) or T.Card2, Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.Text, AutoButtonColor = false, BorderSizePixel = 0 }, r)
	round(b, 8)
	b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = (danger and Color3.fromRGB(150, 50, 66)) or T.Line }) end)
	b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = danger and Color3.fromRGB(116, 40, 52) or T.Card2 }) end)
	b.MouseButton1Click:Connect(cb)
end

function Tab:Label(text, h)
	local r = self:row(h or 34)
	r.BackgroundTransparency = 1
	return new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = text }, r)
end

