local function cleanup()
	alive = false
	pcall(function() RunService:UnbindFromRenderStep("SniperAimbot") end)
	pcall(hbRestoreAll)
	pcall(stopFly)
	pcall(setFullbright, false)
	pcall(function()
		local h = myHum()
		if h then
			if wasSpeed then h.WalkSpeed = 16 end
			if wasJump then h.JumpPower = 50 end
		end
	end)
	for k in pairs(espObjs) do removeEsp(k) end
	for k in pairs(chamsObjs) do removeChams(k) end
	for _, o in ipairs({ fovCircle, silentCircle, chH, chV }) do if o then pcall(function() o:Remove() end) end end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	if gui then gui:Destroy() end
	env.__SniperArenaCleanup = nil
end
env.__SniperArenaCleanup = cleanup
topBtn("X", -38, cleanup)

local busy = false
local function toggleMenu()
	if busy or not alive then return end
	busy = true
	if main.Visible then
		tween(mainScale, 0.18, { Scale = 0.85 })
		task.delay(0.18, function()
			main.Visible = false
			mainScale.Scale = 1
			busy = false
		end)
	else
		mainScale.Scale = 0.85
		main.Visible = true
		tween(mainScale, 0.2, { Scale = 1 })
		task.delay(0.2, function() busy = false end)
	end
end

connect(UserInputService.InputBegan, function(i, processed)
	if processed then return end
	if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == S.menuKey then
		toggleMenu()
	end
end)

