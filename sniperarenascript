local function removeEsp(key)
	local e = espObjs[key]
	if e then
		for k, o in pairs(e) do
			if type(o) ~= "number" and type(o) ~= "boolean" and o then pcall(function() o:Remove() end) end
		end
		espObjs[key] = nil
	end
end

local chamsObjs = {}
local function removeChams(key)
	if chamsObjs[key] then pcall(function() chamsObjs[key]:Destroy() end) end
	chamsObjs[key] = nil
end
local function updateChams()
	if not S.chams then
		for k in pairs(chamsObjs) do removeChams(k) end
		return
	end
	local list = {}
	local camPos = Camera.CFrame.Position
	for _, t in ipairs(targets) do
		if not (S.espTeamCheck and isTeammate(t)) then
			list[#list + 1] = { t = t, d = (t.root.Position - camPos).Magnitude }
		end
	end
	table.sort(list, function(a, b) return a.d < b.d end)
	local keep = {}
	for i = 1, math.min(#list, 30) do -- Roblox-Limit: ca. 31 Highlights
		local ch = list[i].t.char
		keep[ch] = true
		local h = chamsObjs[ch]
		if not h or not h.Parent then
			h = new("Highlight", { Adornee = ch, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, gui)
			chamsObjs[ch] = h
		end
		h.FillColor = T.Accent
		h.OutlineColor = Color3.new(1, 1, 1)
		h.FillTransparency = S.chamsFill
		h.OutlineTransparency = S.chamsOutline
	end
	for k in pairs(chamsObjs) do
		if not keep[k] then removeChams(k) end
	end
end

local function drawEspOne(t, e, vp, now)
	if S.espTeamCheck and isTeammate(t) then hideEsp(e) return end
	local root = t.root
	local rp = root.Position
	local camPos = Camera.CFrame.Position
	local d = (rp - camPos).Magnitude
	if d > S.espMaxDist then hideEsp(e) return end
	-- feste Masse statt GetBoundingBox: bleibt korrekt bei Hitbox-Expander und Waffen in der Hand
	local head = t.char:FindFirstChild("Head")
	local topW = (head and head.Position or rp + Vector3.new(0, 2.5, 0)) + Vector3.new(0, 0.8, 0)
	local botW = rp - Vector3.new(0, 3.1, 0)
	local tp = Camera:WorldToViewportPoint(topW)
	local bp = Camera:WorldToViewportPoint(botW)
	if tp.Z <= 0 or bp.Z <= 0 then hideEsp(e) return end
	local h = math.max(math.abs(bp.Y - tp.Y), 8)
	local w = h * 0.55
	local cx = (tp.X + bp.X) / 2
	local x, y = cx - w / 2, math.min(tp.Y, bp.Y)

	local col = isTeammate(t) and T.Good or T.Accent
	if S.espVisColor then
		if now - e.visT > 0.15 then
			e.visT = now
			e.vis = isVisible(pickPart(t, "Head"), t.char)
		end
		col = e.vis and T.Good or T.Bad
	end

	if e.box then e.box.Visible = S.espBox; e.box.Position = Vector2.new(x, y); e.box.Size = Vector2.new(w, h); e.box.Color = col end
	if e.boxO then e.boxO.Visible = S.espBox; e.boxO.Position = Vector2.new(x, y); e.boxO.Size = Vector2.new(w, h) end
	if e.name then e.name.Visible = S.espName; e.name.Text = t.name; e.name.Position = Vector2.new(cx, y - 16) end
	if e.dist then e.dist.Visible = S.espDist; e.dist.Text = math.floor(d) .. " m"; e.dist.Position = Vector2.new(cx, y + h + 2) end
	if e.hp and e.hpBg then
		local frac = t.hum and math.clamp(t.hum.Health / math.max(t.hum.MaxHealth, 1), 0, 1) or 1
		local bx = x - 5
		e.hpBg.Visible = S.espHealth; e.hpBg.From = Vector2.new(bx, y + h); e.hpBg.To = Vector2.new(bx, y)
		e.hp.Visible = S.espHealth; e.hp.From = Vector2.new(bx, y + h); e.hp.To = Vector2.new(bx, y + h - h * frac)
		e.hp.Color = Color3.fromRGB(255, 80, 80):Lerp(Color3.fromRGB(70, 214, 140), frac)
	end
	if e.tracer then e.tracer.Visible = S.espTracer; e.tracer.From = Vector2.new(vp.X / 2, vp.Y); e.tracer.To = Vector2.new(cx, y + h); e.tracer.Color = col end
end

local function updateEsp(now)
	if not hasDrawing then return end
	if not S.esp then
		for _, e in pairs(espObjs) do hideEsp(e) end
		return
	end
	local vp = Camera.ViewportSize
	local seen = {}
	for _, t in ipairs(targets) do
		seen[t.char] = true
		local e = espObjs[t.char]
		if not e then e = makeEsp() espObjs[t.char] = e end
		if not pcall(drawEspOne, t, e, vp, now) then hideEsp(e) end
	end
	for key in pairs(espObjs) do
		if not seen[key] then removeEsp(key) end
	end
end

-- ============================================================
-- Hitbox Expander (jeden Frame erneuert, damit das Spiel sie nicht zuruecksetzt)
-- ============================================================
local hbOrig = setmetatable({}, { __mode = "k" })
local function hbRestoreAll()
	for part, o in pairs(hbOrig) do
		if part and part.Parent then
			pcall(function()
				part.Size = o.s
				part.Transparency = o.t
				part.CanCollide = o.c
				part.Massless = o.m
			end)
		end
		hbOrig[part] = nil
	end
end
local function hbApply(part, size)
	local o = hbOrig[part]
	if not o then
		o = { s = part.Size, t = part.Transparency, c = part.CanCollide, m = part.Massless }
		hbOrig[part] = o
	end
	if part.Size ~= size then part.Size = size end
	part.Transparency = S.hitboxTrans
	part.CanCollide = false
	part.Massless = true
end
local function updateHitboxes()
	if not S.hitbox then
		if next(hbOrig) then hbRestoreAll() end
		return
	end
	local sz = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
	for _, t in ipairs(targets) do
		if not (S.hitboxTeamCheck and isTeammate(t)) then
			local c = t.char
			if S.hitboxPart == "HumanoidRootPart" or S.hitboxPart == "Beides" then
				local r = c:FindFirstChild("HumanoidRootPart") or t.root
				if r and r:IsA("BasePart") then pcall(hbApply, r, sz) end
			end
			if S.hitboxPart == "Head" or S.hitboxPart == "Beides" then
				local hd = c:FindFirstChild("Head")
				if hd and hd:IsA("BasePart") then pcall(hbApply, hd, sz) end
			end
		end
	end
end

