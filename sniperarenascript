-- Ziele sammeln (EINMAL pro Frame, alle Module nutzen dieselbe Liste)
-- ============================================================
local targets = {}      -- lebende Ziele: { player, char, hum, root, name, team }
local charSet = {}      -- ALLE Charaktere der anderen Spieler (auch tote) fuer die Remote-Erkennung
local npcCache = {}
local myPos = nil

local function rootOf(c)
	return c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart or c:FindFirstChild("Torso")
		or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Head")
end
local function myHum() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function myRoot() local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end

local function isTeammate(t)
	return t.team ~= nil and LP.Team ~= nil and t.team == LP.Team
end

local function collectTargets()
	table.clear(targets)
	table.clear(charSet)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local c = p.Character or workspace:FindFirstChild(p.Name)
			if c and c:IsA("Model") then
				charSet[c] = true
				local hum = c:FindFirstChildOfClass("Humanoid")
				local root = rootOf(c)
				if root and (not hum or hum.Health > 0) then
					targets[#targets + 1] = { player = p, char = c, hum = hum, root = root, name = p.DisplayName, team = p.Team }
				end
			end
		end
	end
	if S.targetNpcs then
		for _, m in ipairs(npcCache) do
			if m.Parent and m ~= LP.Character then
				local hum = m:FindFirstChildOfClass("Humanoid")
				local root = rootOf(m)
				if root and hum and hum.Health > 0 then
					charSet[m] = true
					targets[#targets + 1] = { char = m, hum = hum, root = root, name = m.Name }
				end
			end
		end
	end
end

