local ownCall = false -- true, solange das Script selbst Raycasts macht (damit die Hooks sie nicht veraendern)

local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude
visParams.IgnoreWater = true
local function isVisible(part, char)
	ownCall = true
	local origin = Camera.CFrame.Position
	local ign = { LP.Character, Camera }
	local result = false
	for _ = 1, 4 do
		visParams.FilterDescendantsInstances = ign
		local res = workspace:Raycast(origin, part.Position - origin, visParams)
		if not res then result = true break end
		local inst = res.Instance
		if inst:IsDescendantOf(char) then result = true break end
		if inst.Transparency >= 0.9 then ign[#ign + 1] = inst else break end
	end
	ownCall = false
	return result
end

local function mouseLoc() return UserInputService:GetMouseLocation() end

local function pickPart(t, partName)
	local c = t.char
	return c:FindFirstChild(partName) or c:FindFirstChild("Head") or t.root
end

-- useFov = nur Ziele im FOV-Kreis; sonst alle (Magic Bullets)
local function getTarget(partName, fov, useFov, wall, maxDist)
	local best, bestScore
	local ml = mouseLoc()
	local cf = Camera.CFrame
	local camPos, look = cf.Position, cf.LookVector
	for _, t in ipairs(targets) do
		if not (S.teamCheck and isTeammate(t)) then
			local part = pickPart(t, partName)
			if part then
				local pos = part.Position
				local dist = (pos - camPos).Magnitude
				if dist <= maxDist then
					local sp = Camera:WorldToViewportPoint(pos)
					local sd = (Vector2.new(sp.X, sp.Y) - ml).Magnitude
					local ok = true
					if useFov then ok = sp.Z > 0 and sd <= fov end
					if ok and wall and not isVisible(part, t.char) then ok = false end
					if ok then
						local score
						if S.priority == "Distanz" then
							score = dist
						elseif S.priority == "Leben" then
							score = t.hum and t.hum.Health or 100
						elseif useFov then
							score = sd
						else
							score = math.acos(math.clamp(look:Dot((pos - camPos).Unit), -1, 1))
						end
						if not bestScore or score < bestScore then
							bestScore = score
							best = { player = t.player, char = t.char, hum = t.hum, root = t.root, part = part, name = t.name }
						end
					end
				end
			end
		end
	end
	return best
end

