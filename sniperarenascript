RunService:BindToRenderStep("SniperAimbot", Enum.RenderPriority.Camera.Value + 1, function()
	if not alive then return end
	pcall(function()
		if S.aimbot and aimKeyDown() then
			local tgt
			if S.stickyTarget and stickyLock and stickyLock.part.Parent and (not stickyLock.hum or stickyLock.hum.Health > 0) then
				tgt = stickyLock
			else
				tgt = getTarget(S.aimPart, S.aimFov, true, S.wallCheck, S.aimMaxDist)
				stickyLock = tgt
			end
			if tgt then
				local part = tgt.part
				local vel = tgt.root and tgt.root.AssemblyLinearVelocity or Vector3.zero
				local aimPos = part.Position + vel * S.predict
				local k = 1 / math.max(S.smooth, 1)
				local cam = workspace.CurrentCamera
				if S.aimMethod == "Maus" and hasMouseRel then
					local sp = cam:WorldToViewportPoint(aimPos)
					if sp.Z > 0 then
						local m = mouseLoc()
						mousemoverel((sp.X - m.X) * k, (sp.Y - m.Y) * k)
					end
				else
					cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimPos), k)
				end
			end
		else
			stickyLock = nil
		end
	end)
end)

