-- ============================================================
-- Silent Aim / Magic Bullets (Hooks)
-- ============================================================
local silentTarget = nil
local realHitPos, realTarget = Vector3.zero, nil

local function silentActive() return alive and (S.silent or S.magic) and silentTarget ~= nil end

local rollT, rollV = 0, true
local function roll()
	if S.magic then return true end
	local n = os.clock()
	if n - rollT > 0.25 then
		rollT = n
		rollV = math.random(1, 100) <= S.hitChance
	end
	return rollV
end

-- Ist dieser Raycast ein Schuss? (lang + startet an Kamera/Charakter) -> verhindert, dass Boden-/Kamera-Raycasts kaputtgehen
local function isShotRay(origin, dir)
	if typeof(origin) ~= "Vector3" or typeof(dir) ~= "Vector3" then return false end
	if dir.Magnitude < 60 then return false end
	if (origin - Camera.CFrame.Position).Magnitude < 25 then return true end
	return myPos ~= nil and (origin - myPos).Magnitude < 25
end

local function inCharSet(inst)
	local a = inst
	for _ = 1, 7 do
		if not a then return nil end
		if charSet[a] then return a end
		a = a.Parent
	end
	return nil
end

-- Remote-Argumente (Instanzen, Positionen, Richtungen, CFrames, Tabellen) auf das Ziel umschreiben
local function spoofArg(v, key, depth, named)
	local t = silentTarget
	local tpos = t.part.Position
	local tv = typeof(v)
	local k = type(key) == "string" and key:lower() or nil
	if tv == "Instance" then
		local ch = inCharSet(v)
		if ch then
			if v == ch then return t.char end
			if v:IsA("Humanoid") then return t.hum or v end
			if v:IsA("BasePart") then return t.part end
			return v
		end
		if realTarget and v == realTarget then return t.part end
		return v
	elseif tv == "Vector3" then
		local cp = Camera.CFrame.Position
		local m = v.Magnitude
		if k then
			if k:find("dir", 1, true) then return (tpos - cp).Unit * (m > 0 and m or 1) end
			if k:find("origin", 1, true) or k:find("start", 1, true) or k:find("from", 1, true) or k:find("muzzle", 1, true) or k:find("normal", 1, true) then return v end
			if k:find("pos", 1, true) or k:find("hit", 1, true) or k:find("target", 1, true) or k:find("end", 1, true) or k:find("point", 1, true) then return tpos end
		end
		if math.abs(m - 1) < 0.02 then return (tpos - cp).Unit end
		if (v - cp).Magnitude < 20 or (myPos and (v - myPos).Magnitude < 20) then return v end
		if (v - realHitPos).Magnitude < 60 then return tpos end
		local hv = realHitPos - cp
		if m >= 2 and m <= 10000 and hv.Magnitude > 1 and v.Unit:Dot(hv.Unit) > 0.97 then return (tpos - cp).Unit * m end
		if named then return tpos end
		return v
	elseif tv == "CFrame" then
		local p = v.Position
		local cp = Camera.CFrame.Position
		if (p - cp).Magnitude < 20 or (myPos and (p - myPos).Magnitude < 20) then return CFrame.lookAt(p, tpos) end
		if (p - realHitPos).Magnitude < 60 or named then return CFrame.new(tpos) end
		return v
	elseif tv == "table" and depth < 3 then
		local n = {}
		for kk, vv in pairs(v) do n[kk] = spoofArg(vv, kk, depth + 1, named) end
		return n
	end
	return v
end

local SHOT_KEYS = { "shoot", "fire", "hit", "damage", "bullet", "gun", "weapon", "ray", "proj", "attack", "shot", "snip", "kill", "dmg", "cast" }
local function namedShot(name)
	name = string.lower(name)
	for _, k in ipairs(SHOT_KEYS) do
		if name:find(k, 1, true) then return true end
	end
	return false
end

local logT = {}
local function logRemote(remote, pk)
	local now = os.clock()
	local nm = remote.Name
	if now - (logT[nm] or 0) < 0.25 then return end
	logT[nm] = now
	local parts = {}
	for i = 1, pk.n do
		local v = pk[i]
		local tv = typeof(v)
		if tv == "Instance" then tv = "Instance(" .. v.Name .. ")"
		elseif tv == "Vector3" or tv == "CFrame" or tv == "number" or tv == "string" or tv == "boolean" then tv = tv .. "=" .. tostring(v) end
		parts[#parts + 1] = tv
	end
	print("[SniperLog] " .. nm .. " (" .. remote.ClassName .. ") -> " .. table.concat(parts, " | "))
end

local hooksOk = false
do
	local cc = checkcaller or function() return false end
	local ncc = newcclosure or function(f) return f end
	local function setM(m) if setnamecallmethod then setnamecallmethod(m) end end

	hooksOk = pcall(function()
		assert(hookmetamethod and getnamecallmethod)
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", ncc(function(self, ...)
			local method = getnamecallmethod()
			if not alive or ownCall or cc() then return oldNamecall(self, ...) end

			if method == "FireServer" or method == "InvokeServer" then
				local pk = table.pack(...)
				if S.remoteLog then
					ownCall = true
					pcall(logRemote, self, pk)
					ownCall = false
				end
				if S.remoteSpoof and silentActive() and roll() then
					ownCall = true
					local okS, res = pcall(function()
						local named = namedShot(self.Name)
						if S.remoteOnlyNamed and not named then return nil end
						local out = { n = pk.n }
						for i = 1, pk.n do out[i] = spoofArg(pk[i], nil, 0, named) end
						return out
					end)
					ownCall = false
					setM(method)
					if okS and res then return oldNamecall(self, table.unpack(res, 1, res.n)) end
				end
				setM(method)
				return oldNamecall(self, ...)

			elseif method == "Raycast" then
				if self == workspace and silentActive() and roll() then
					local o, d, p = ...
					if isShotRay(o, d) then
						local tpos = silentTarget.part.Position
						local need = math.max(d.Magnitude, (tpos - o).Magnitude + 5)
						local nd = (tpos - o).Unit * need
						local np = p
						if S.magic and S.magicThroughWalls then
							np = RaycastParams.new()
							np.FilterType = Enum.RaycastFilterType.Include
							np.FilterDescendantsInstances = { silentTarget.char }
						end
						setM("Raycast")
						return oldNamecall(self, o, nd, np)
					end
				end

			elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
				if self == workspace and silentActive() and roll() then
					local ray = ...
					if typeof(ray) == "Ray" and isShotRay(ray.Origin, ray.Direction) then
						local tpos = silentTarget.part.Position
						local need = math.max(ray.Direction.Magnitude, (tpos - ray.Origin).Magnitude + 5)
						local nr = Ray.new(ray.Origin, (tpos - ray.Origin).Unit * need)
						if S.magic and S.magicThroughWalls then
							setM("FindPartOnRayWithWhitelist")
							return oldNamecall(self, nr, { silentTarget.char })
						end
						setM(method)
						return oldNamecall(self, nr, select(2, ...))
					end
				end

			elseif method == "ViewportPointToRay" or method == "ScreenPointToRay" then
				if self == Camera and silentActive() and roll() then
					setM(method)
					local ray = oldNamecall(self, ...)
					return Ray.new(ray.Origin, (silentTarget.part.Position - ray.Origin).Unit)
				end

			elseif method == "GetMouseLocation" then
				if S.mouseSpoof and self == UserInputService and silentActive() and roll() then
					ownCall = true
					local sp = Camera:WorldToViewportPoint(silentTarget.part.Position)
					ownCall = false
					if sp.Z > 0 then return Vector2.new(sp.X, sp.Y) end
					setM(method)
				end
			end
			return oldNamecall(self, ...)
		end))

		local oldIndex
		oldIndex = hookmetamethod(game, "__index", ncc(function(self, key)
			if self == Mouse and alive and not ownCall and (key == "Hit" or key == "Target" or key == "UnitRay")
				and silentActive() and not cc() and roll() then
				if key == "Hit" then return CFrame.new(silentTarget.part.Position) end
				if key == "Target" then return silentTarget.part end
				local o = Camera.CFrame.Position
				return Ray.new(o, (silentTarget.part.Position - o).Unit)
			end
			return oldIndex(self, key)
		end))
	end)
end

